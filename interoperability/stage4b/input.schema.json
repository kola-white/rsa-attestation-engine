{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage4B trusted local synthetic verifier input",
  "type": "object",
  "required": ["credential", "trust", "policy"],
  "properties": {
    "credential": {
      "type": "string",
      "maxLength": 1048576
    },
    "trust": {
      "type": "object",
      "required": [
        "synthetic",
        "issuer",
        "kid",
        "publicKey",
        "authorityIssuer",
        "authorityKid",
        "authorityKey",
        "statusIssuer",
        "statusKid",
        "statusKey"
      ],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "kid": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        },
        "authorityIssuer": {
          "type": "string"
        },
        "authorityKid": {
          "type": "string"
        },
        "authorityKey": {
          "type": "string"
        },
        "statusIssuer": {
          "type": "string"
        },
        "statusKid": {
          "type": "string"
        },
        "statusKey": {
          "type": "string"
        },
        "synthetic": {
          "const": true
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["now", "expectedSubject"],
      "properties": {
        "now": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedSubject": {
          "type": "string"
        },
        "maxStatusAgeSeconds": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 900
        }
      }
    },
    "authorityJws": {
      "type": "string"
    },
    "status": {
      "type": ["object", "null"],
      "properties": {
        "availability": {
          "type": "string"
        },
        "jws": {
          "type": "string"
        }
      }
    },
    "holder": {
      "type": "string"
    }
  }
}
