<mj-section padding="22px 28px 0 28px">
  <mj-column>
    <mj-divider border-width="1px" border-color="#E4E7EC" padding="0 0 18px 0" />
    <mj-text font-size="12px" line-height="18px" color="#667085" padding="0 0 8px 0">
