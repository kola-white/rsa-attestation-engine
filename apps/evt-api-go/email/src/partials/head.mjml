<mj-attributes>
  <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif" />
  <mj-body background-color="#f6f7f9" />
  <mj-section padding="0" />
  <mj-column padding="0" />
  <mj-text color="#172033" font-size="15px" line-height="24px" padding="0" />
  <mj-button background-color="#5B246C" color="#ffffff" border-radius="10px" font-size="15px" font-weight="600" inner-padding="14px 22px" padding="0" />
</mj-attributes>
<mj-style inline="inline">
  .muted { color: #667085; }
  .eyebrow { letter-spacing: 0.08em; text-transform: uppercase; }
  .code-box { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace; letter-spacing: 0.18em; }
</mj-style>
